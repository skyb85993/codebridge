{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "webchat/webchat-title",
  "provider": {
    "webchat": {
      "name": "Web Chat (CodeBridge)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:9224/v1"
      },
      "models": {
        "webchat-chatgpt": {
          "name": "ChatGPT (web)",
          "tool_call": true
        },
        "webchat-gemini": {
          "name": "Google Gemini (web)",
          "tool_call": true
        },
        "webchat-title": {
          "name": "CodeBridge Title Generator",
          "tool_call": false
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "shell": "allow",
    "webfetch": "allow",
    "execute": "deny"
  }
}
